# ThreatLens environment — copy to .env and fill values. Never commit real secrets.

APP_NAME=ThreatLens
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
API_VERSION=v1
THREATLENS_VERSION=1.0.0
DEMO_MODE=true
LOG_LEVEL=INFO

# Database / cache / search
DATABASE_URL=postgresql+psycopg://threatlens:threatlens@postgres:5432/threatlens
REDIS_URL=redis://redis:6379/0
ELASTICSEARCH_URL=http://opensearch:9200

# Auth
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
ENCRYPTION_KEY=change-me-fernet-or-32-byte-key-value
COOKIE_SECURE=false

# Email
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM=ThreatLens <noreply@threatlens.local>
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

# Threat intelligence / enrichment (optional; seed data works without keys)
OTX_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
MALWAREBAZAAR_API_KEY=
URLHAUS_AUTH_KEY=

# AI triage (optional; deterministic evidence summarizer is used if empty)
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Demo seed
SEED_ON_START=true
