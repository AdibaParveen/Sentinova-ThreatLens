# ============================================================
# ThreatLens environment template
# ============================================================
# Copy this file to .env.
#
# IMPORTANT:
# - Never commit .env
# - Never use these development settings in production
# - Generate strong secrets before production deployment
# ============================================================

APP_NAME=ThreatLens
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
API_VERSION=v1
THREATLENS_VERSION=1.0.0

DEMO_MODE=true
LOG_LEVEL=INFO
SEED_ON_START=true


# ============================================================
# Database / Cache / Search
# ============================================================

DATABASE_URL=postgresql+psycopg://threatlens:threatlens@postgres:5432/threatlens
REDIS_URL=redis://redis:6379/0
ELASTICSEARCH_URL=http://opensearch:9200


# ============================================================
# Authentication
# ============================================================
#
# For local demo mode these may remain empty.
#
# For staging/production generate them with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Generate a DIFFERENT value for every secret.
#

JWT_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Fernet-compatible key is recommended.
# Generate with:
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
ENCRYPTION_KEY=

# false for local HTTP
# true for HTTPS production
COOKIE_SECURE=false


# ============================================================
# Email
# ============================================================

EMAIL_PROVIDER=smtp
EMAIL_API_KEY=

EMAIL_FROM=ThreatLens <noreply@threatlens.local>

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false


# ============================================================
# Threat Intelligence / Enrichment
# ============================================================

OTX_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
MALWAREBAZAAR_API_KEY=
URLHAUS_AUTH_KEY=


# ============================================================
# AI Triage
# ============================================================

AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini


# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=http://localhost:3000